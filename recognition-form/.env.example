# =================================================================
# الكُتّاب - ملف متغيرات البيئة التوضيحي (Environment Variables Template)
# =================================================================
# قم بنسخ هذا الملف وإنشاء ملف جديد باسم `.env` في نفس المجلد الأساسي
# ثم استبدل القيم التوضيحية بالقيم الخاصة بحساباتك على Firebase و Cloudinary
# =================================================================

# 1. إعدادات منصة Firebase 🌐
# احصل على هذه البيانات من: Firebase Console -> Project Settings -> General -> Your Apps (Web)
VITE_FIREBASE_API_KEY=AIzaSyA_ExampleApiKey123456789
VITE_FIREBASE_AUTH_DOMAIN=kuttab-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kuttab-app
VITE_FIREBASE_STORAGE_BUCKET=kuttab-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# 2. إعدادات منصة Cloudinary لتخزين الصور 📸
# احصل على هذه البيانات من: Cloudinary Dashboard -> Settings -> Upload -> Unsigned Upload Presets
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=kuttab_unsigned_preset

# 3. كلمة مرور لوحة التحكم والإدارة 🔐 (افتراضي: kuttab2026)
VITE_ADMIN_PASSWORD=kuttab
